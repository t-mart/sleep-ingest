          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT\n  count(*) FILTER (WHERE kind = 'Obstructive Apnea') AS \"Obstructive\",\n  count(*) FILTER (WHERE kind = 'Hypopnea') AS \"Hypopnea\",\n  count(*) FILTER (WHERE kind = 'Central Apnea') AS \"Central\",\n  count(*) FILTER (WHERE kind = 'Apnea') AS \"Unclassified\",\n  count(*) FILTER (WHERE kind = 'Arousal') AS \"Arousal\"\nFROM event\nWHERE $__timeFilter(time)",
