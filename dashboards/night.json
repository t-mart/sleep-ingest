      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sleep_ingest_timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT duration_min / 60.0 AS \"Usage\" FROM daily_summary\nWHERE day IN (\n  SELECT day FROM mask_session\n  WHERE mask_on < $__timeTo() AND coalesce(mask_off, mask_on) > $__timeFrom()\n)\nORDER BY day DESC\nLIMIT 1",
          "format": "table"
        }
      ],
      "description": "The last night that has mask time in the range."
    },
