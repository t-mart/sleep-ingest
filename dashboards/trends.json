      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sleep_ingest_timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT 100.0 * count(*) FILTER (WHERE duration_min >= 240) / NULLIF(max(day) - min(day) + 1, 0) AS \"Compliance\"\nFROM daily_summary\nWHERE (day + time '12:00') AT TIME ZONE ${TimeZone:sqlstring} BETWEEN $__timeFrom() AND $__timeTo()",
          "format": "table"
        }
      ],
      "description": "Nights with 4 hours or more of use, as a percentage of the days from the first to the last night in the range."
    },
