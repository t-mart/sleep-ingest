      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sleep_ingest_timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE duration_min > 0) AS \"Nights\"\nFROM daily_summary\nWHERE (day + time '12:00') AT TIME ZONE ${TimeZone:sqlstring} BETWEEN $__timeFrom() AND $__timeTo()",
          "format": "table"
        }
      ]
    },
