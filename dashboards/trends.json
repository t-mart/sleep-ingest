      "title": "Therapy times",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sleep_ingest_timescaledb"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "calculate": false,
        "cellGap": 0,
        "cellValues": {
          "unit": "m",
          "decimals": 0
        },
        "color": {
          "mode": "opacity",
          "fill": "#3987e5",
          "scale": "linear",
          "exponent": 0.5,
          "steps": 64,
          "reverse": false,
          "min": 0,
