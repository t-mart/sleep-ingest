      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sleep_ingest_timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT day AS \"Night\", key AS \"Setting\",\n  prev ->> key AS \"Before\", settings ->> key AS \"After\"\nFROM (\n  SELECT day, settings, lag(settings) OVER (ORDER BY day) AS prev\n  FROM daily_summary\n) d, jsonb_object_keys(settings) AS key\nWHERE prev IS NOT NULL AND prev -> key IS DISTINCT FROM settings -> key\n  AND (day + time '12:00') AT TIME ZONE ${TimeZone:sqlstring} BETWEEN $__timeFrom() AND $__timeTo()\nORDER BY day DESC, key",
          "format": "table"
        }
      ],
      "description": "Device settings that differ from the night before. The values are device codes."
    }
