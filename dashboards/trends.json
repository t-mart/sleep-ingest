      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sleep_ingest_timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT d.day AS \"Night\",\n  extract(epoch FROM min(s.mask_on)) * 1000 AS \"Mask on\",\n  extract(epoch FROM max(coalesce(s.mask_off, s.mask_on))) * 1000 AS \"Mask off\",\n  count(s.slot) AS \"Sessions\",\n  d.duration_min / 60.0 AS \"Usage\",\n  d.ahi AS \"AHI\",\n  d.leak_95 * 60 AS \"Leak 95%\",\n  d.mask_press_95 AS \"Pressure 95%\",\n  extract(epoch FROM min(s.mask_on) - interval '15 minutes') * 1000 AS \"from\",\n  extract(epoch FROM max(coalesce(s.mask_off, s.mask_on)) + interval '15 minutes') * 1000 AS \"to\"\nFROM daily_summary d LEFT JOIN mask_session s USING (day)\nWHERE (d.day + time '12:00') AT TIME ZONE ${TimeZone:sqlstring} BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY d.day\nORDER BY d.day DESC",
          "format": "table"
        }
      ],
      "description": "Select a night to open it in the night dashboard."
    },
